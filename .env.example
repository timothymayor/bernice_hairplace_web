# Copy to .env.local for local development (`vercel dev`), and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# Variables prefixed VITE_ are bundled into the public site. Never put secrets in them.

# ── Supabase (Project Settings → API) ──
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
# Server-only. Bypasses row-level security, so never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Paystack (Settings → API Keys & Webhooks) ──
# Use sk_test_... for Preview deployments and sk_live_... for Production.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# ── Mailgun (order confirmation emails) ──
MAILGUN_API_KEY="your-mailgun-private-api-key"
MAILGUN_DOMAIN="mg.bernicehairplace.com"
MAILGUN_FROM_EMAIL="Bernice Hairplace <orders@mg.bernicehairplace.com>"
# "us" (default) or "eu", matching the region of your Mailgun domain.
MAILGUN_REGION="us"
# Optional: receives a copy (BCC) of every order confirmation.
STORE_NOTIFICATION_EMAIL="orders@bernicehairplace.com"

# ── Site ──
# Public URL used for links and images in emails (defaults to the request host).
SITE_URL="https://bernicehairplace.com"
# WhatsApp number for enquiries (international format, digits only).
VITE_WHATSAPP_NUMBER="2348128904120"
